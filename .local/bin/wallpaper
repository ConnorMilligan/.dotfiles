#!/usr/bin/env bash

IMG_DIR="$HOME/Pictures"
HORSE0="$IMG_DIR/horse0.jpg"
HORSE1="$IMG_DIR/horse1.jpg"

R=$((RANDOM % 6))

if [[ $R -eq 0 ]]; then
    SELECTED_IMAGE="$HORSE1"
else
    SELECTED_IMAGE="$HORSE0"
fi

OLD_PID=$(pgrep swaybg)

swaybg -i "$SELECTED_IMAGE" -m fill &

NEW_PID=$!

sleep 0.5

if [[ -n "$OLD_PID" ]]; then
    kill "$OLD_PID"
fi

echo "started $NEW_PID and killed $OLD_PID. Selected horse: $R" > /tmp/horse.log
