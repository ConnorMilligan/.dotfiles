# Pull the latest nightly binary of zig and put it in ~/.local/bin 

# Get the latest nightly binary
# link in format: https://ziglang.org/builds/zig-linux-x86_64-0.12.0-dev.3480+9dac8db2d.tar.xz
# should pull https://ziglang.org/builds/zig-linux-x86_64-*-dev*.tar.xz

# colors
RED='\e[1;31m'
GREEN='\e[1;32m'
NC='\e[0m'

# binary
bin_name="nzig"

# Get the latest nightly binary
latest_package=$(curl -s https://ziglang.org/download/ | grep -oP 'https://ziglang.org/builds/zig-linux-x86_64-.*?-dev.*?\.tar\.xz' | head -n 1)
latest_version=$(echo $latest_package | grep -oP 'zig-linux-x86_64-\K[0-9]+\.[0-9]+\.[0-9]+-dev\.\d+\+[a-z0-9]+')
old_version="Not installed"

# check old version of zig-nightly
if [ -f ~/.local/bin/$bin_name ]; then
    old_version=$($bin_name version)
fi

# be sure zig-nightly is not already at the latest version
if [ -f ~/.local/bin/$bin_name ]; then
    if [ "$old_version" = "$latest_version" ]; then
        echo -e "zig nightly is already at the latest version (${GREEN}$latest_version${NC})"
        exit 0
    fi
fi

echo -e "Old version: ${RED}$old_version${NC}"
echo -e "Found version ${GREEN}$latest_version${NC}\n"

# download the package
echo "Downloading $latest_package..."
wget -O /tmp/zig-nightly.tar.xz $latest_package

# extract the package
echo "Extracting zig-nightly.tar.xz..."
tar -xf /tmp/zig-nightly.tar.xz -C /tmp 

echo "Removing old install..."
rm -rf ~/.local/bin/doc
rm -rf ~/.local/bin/lib
rm ~/.local/bin/$bin_name

# move the binary to ~/.local/bin 
echo "Moving files to ~/.local/bin..."
mv /tmp/zig-linux-x86_64-*/* ~/.local/bin 
mv ~/.local/bin/zig ~/.local/bin/$bin_name

# cleanup
echo "Cleaning up..."
rm -rf /tmp/zig-linux-x86_64-*
rm -rf /tmp/zig-nightly.tar.xz
rm -rf ~/.local/bin/LICENSE
rm -rf ~/.local/bin/README.md

# echo the installed version and old version
installed_version=$($bin_name version)
echo -e "Installed version: ${GREEN}$installed_version${NC}"
echo -e "Old version: ${RED}$old_version${NC}"

# print if the version has changed
if [ "$old_version" == "$installed_version" ]; then
    echo -e "${RED}Version has not changed${NC}"
else
    echo -e "${GREEN}Version has changed${NC}"
fi
